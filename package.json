{
  "name": "proto",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "create-agent": "tsx --env-file-if-exists=.env src/create-agent.ts",
    "issue-grant": "tsx --env-file-if-exists=.env src/issue-grant.ts",
    "revoke-grant": "tsx --env-file-if-exists=.env src/revoke-grant.ts",
    "update-policy": "tsx --env-file-if-exists=.env src/update-policy.ts",
    "deposit": "tsx --env-file-if-exists=.env src/deposit.ts",
    "inspect": "tsx --env-file-if-exists=.env src/inspect.ts",
    "rebalance": "tsx --env-file-if-exists=.env src/rebalance.ts",
    "sweep": "tsx --env-file-if-exists=.env src/sweep.ts",
    "refusals": "tsx --env-file-if-exists=.env src/refusals.ts",
    "steward": "tsx --env-file-if-exists=.env src/steward.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/reconcile.ts",
    "books": "tsx --env-file-if-exists=.env src/books.ts",
    "autopilot": "tsx --env-file-if-exists=.env src/autopilot-tick.ts",
    "archive": "tsx --env-file-if-exists=.env src/archive.ts",
    "smoke": "tsx src/smoke.ts",
    "run-report": "tsx src/run-report.ts",
    "typecheck": "tsc && tsc -p web",
    "server": "tsx --env-file-if-exists=.env src/server.ts",
    "hosted": "tsx --env-file-if-exists=.env src/gateway/server.ts",
    "invoices": "tsx --env-file-if-exists=.env src/invoices-server.ts",
    "web": "rsbuild dev --root web",
    "build:web": "rsbuild build --root web",
    "demo": "pnpm build:web && pnpm server",
    "test": "tsx --env-file=test/offline.env --test test/*.test.ts",
    "test:live": "tsx --env-file-if-exists=.env --test test/attestation.test.ts test/execute-plan.test.ts"
  },
  "dependencies": {
    "@fastnear/near-connect": "^0.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@near-intents-agent-api/sdk": "^0.4.1",
    "@nearai/inference-sdk": "^0.1.0",
    "@orpc/client": "2.0.0-beta.43",
    "@orpc/server": "2.0.0-beta.43",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.32",
    "near-kit": "^0.20.2",
    "openai": "^7.31.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
