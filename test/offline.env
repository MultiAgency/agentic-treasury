# Settings for `pnpm test`: placeholders, never .env. Modules that reach the Agent API need a key in
# its format and an agent id to load; nothing is sent, since the API and RPC point at a closed port.
# Without a grant token or a NEAR AI key, the live suites skip: run them with `pnpm test:live`.
NEAR_INTENTS_AGENT_API_KEY=naa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEAR_INTENTS_AGENT_API_URL=http://127.0.0.1:9
NEAR_RPC_URL=http://127.0.0.1:9
AGENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NODE_ENV=test
