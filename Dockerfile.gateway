# Build only from scripts/package-shared-frontends.mjs output, never the working repository.
FROM node:24.22.0-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json ./
COPY src ./src
COPY web/dist ./web/dist
COPY frontends ./frontends
COPY deploy ./deploy
COPY manifest.json ./release-manifest.json
ENV NODE_ENV=production DASHBOARD_FILE=/app/deploy/shared-frontends.json TRUST_PROXY=true
EXPOSE 8080
CMD ["/app/deploy/dashboard-entrypoint.sh"]
