# API key (naa_…) from https://partners.demo.agentsonintents.com/ — backend only, never commit.
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# Owner, for the CLI owner scripts only: the dashboard signs owner actions with a connected wallet.
# A FullAccess key of this NEAR account signs agent creation, policy and grants.
# A dedicated low-value account: whatever this key can reach is what a leak can lose.
AGENT_OWNER_ACCOUNT_ID=
AGENT_OWNER_PRIVATE_KEY=

# Saved by dashboard onboarding or `pnpm create-agent`.
AGENT_ID=
# Saved by dashboard onboarding or `pnpm issue-grant` (ngt_…): the treasury agent's credential. Backend only, never log it.
AGENT_GRANT_TOKEN=
# A new grant's token while the owner signs it; it replaces AGENT_GRANT_TOKEN once that grant is in force.
AGENT_GRANT_TOKEN_PENDING=

# For `pnpm steward`: an LLM on NEAR AI Cloud decides, the policy bounds it. From https://cloud.near.ai/dashboard
NEARAI_API_KEY=

# Saved by the dashboard when the owner links a treasury: any NEAR account, or a Sputnik DAO (acts through Trezu).
TREASURY_ACCOUNT=
# "true" when that DAO is a confidential treasury in Trezu: its payees are not read from public proposals.
TREASURY_CONFIDENTIAL=

# Optional: another instance's own settings file (for example .env.payout), to run a second agent.
# Shared keys still come from .env; AGENT_ID, the grant and the treasury come only from that file.
# Set it in the environment (ENV_FILE=.env.payout pnpm server), not in .env.

# Optional: the NEAR RPC endpoint. Defaults to FastNear's (the paid one when FASTNEAR_API_KEY is set).
# Leave it commented out unless you set a URL: an empty value would replace the default.
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Optional: a FastNear API key (https://dashboard.fastnear.com). Sent as a header to the RPC and the
# Transactions API the DAO watcher reads; without it the free, rate-limited endpoints are used.
FASTNEAR_API_KEY=
