# The Treasury agent's host and name. On the simulated stack, `pnpm stack:credential` writes these.
TREASURY_ORIGIN=https://127.0.0.1:0
TREASURY_AGENT=portfolio

# Owner-issued machine credentials, one per role. Never print or commit them.
TREASURY_PROPOSE_TOKEN=   # read + prepare: status and plans
TREASURY_EXECUTE_TOKEN=   # execute-plan: the owner's approval of one saved plan
TREASURY_SWEEP_TOKEN=     # sweep
